<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/new_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:orientation="vertical">
    <ImageView android:layout_width="58dp" android:layout_height="58dp"
        android:src="@drawable/ic_new_icon" android:scaleType="fitXY"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/new_label" android:textSize="12sp"
        android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF"
        android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3"/>
</LinearLayout>
