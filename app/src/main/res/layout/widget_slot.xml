<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/outline" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/shape_outline" android:scaleType="fitXY" android:visibility="gone"/>
    <ImageView android:id="@+id/frame" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/shape_card" android:scaleType="fitXY"/>
    <ImageView android:id="@+id/inner_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_margin="3dp" android:src="@drawable/shape_inner" android:scaleType="fitXY"/>
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="10dp">
        <FrameLayout android:id="@+id/hdr_wrap" android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageView android:id="@+id/hdr_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/shape_header" android:scaleType="fitXY"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingEnd="6dp">
                <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:padding="12dp" android:textSize="18sp" android:textStyle="bold"
                    android:maxLines="2" android:ellipsize="end"/>
                <ImageView android:id="@+id/btn_open" android:layout_width="34dp" android:layout_height="34dp"
                    android:padding="7dp" android:src="@drawable/ic_open" android:visibility="gone"/>
                <ImageView android:id="@+id/btn_sort" android:layout_width="34dp" android:layout_height="34dp"
                    android:padding="7dp" android:src="@drawable/ic_sort" android:visibility="gone"/>
                <ImageView android:id="@+id/btn_add" android:layout_width="34dp" android:layout_height="34dp"
                    android:padding="7dp" android:src="@drawable/ic_add" android:visibility="gone"/>
                <ImageView android:id="@+id/btn_lock" android:layout_width="34dp" android:layout_height="34dp"
                    android:padding="7dp" android:src="@drawable/ic_lock_closed" android:visibility="gone"/>
            </LinearLayout>
        </FrameLayout>
        <TextView android:id="@+id/alarm" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:layout_marginStart="4dp" android:textSize="13sp"
            android:textStyle="bold" android:textColor="@color/muted" android:visibility="gone"/>
        <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="4dp" android:divider="@null" android:dividerHeight="0dp"/>
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:gravity="center" android:text="@string/empty_slot"
            android:textColor="@color/muted" android:textSize="15sp" android:visibility="gone"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/badge" android:layout_width="18dp" android:layout_height="18dp"
        android:layout_margin="3dp" android:layout_gravity="top|end">
        <ImageView android:id="@+id/badge_fill" android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/shape_badge_fill" android:scaleType="fitXY"/>
        <ImageView android:id="@+id/badge_ring" android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/shape_badge_ring" android:scaleType="fitXY"/>
        <TextView android:id="@+id/slot_num" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold"
            android:includeFontPadding="false"/>
    </FrameLayout>
</FrameLayout>
